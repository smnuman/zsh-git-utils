__git_ai_find_repos() {
    local dir="$1"

    find "$dir" -type d -name .git -not -path '*/\.git/*' -prune 2>/dev/null \
        | xargs -n1 dirname
}

__git_ai_get_repo_name() {
    local pwd="$PWD"
    if [[ "$pwd" = "$HOME/.config" ]]; then
        print "dotconfig"
        return 0
    fi

    local parent=$(basename "$(dirname "$pwd")")
    local current=$(basename "$pwd")

    # Remove leading and trailing dots, replace inner dots with -
    parent=${parent##*.}           # remove leading .
    parent=${parent%%.*}           # remove trailing .
    parent=${parent//./-}          # inner . → -

    current=${current##*.}
    current=${current%%.*}
    current=${current//./-}

    # Avoid empty parts (safety)
    [[ -z "$parent" ]]  && parent="unknown"
    [[ -z "$current" ]] && current="repo"

    print "${parent}-${current}"
}

__git_ai_should_skip_origin() {
    local origin_url="$1"
    [[ -z "$origin_url" || ! "$origin_url" =~ ${GIT_USER} ]]
}

__git_ai_parent_dir() {
    local repo_path="$1"
    dirname "${repo_path%/}"
}

__git_ai_should_skip_gsubignore() {
    local repo_path="$1"                    # full path to the repo, e.g. /home/user/projects/team/web-frontend
    local test_path="$2"                    # "web-frontend/"

    local parent_dir
    parent_dir=$(__git_ai_parent_dir "$repo_path")

    local gsubignore="${parent_dir}/.gsubignore"
    [[ ! -f "$gsubignore" ]] && return 1

    local -a patterns
    # patterns=(${(f)"$(sed '/^[[:space:]]*$/d; /^#/d; s#[[:space:]]*/[[:space:]]*$//' "$gsubignore")"})

    patterns=(${(f)"$(<"$gsubignore")"})
    patterns=("${(@M)patterns:#(#b)([^#[:space:]]##)(*)/?(*)}")   # remove comments + trailing spaces + trailing /
    patterns=("${(@)patterns##[[:space:]]##}")                    # trim leading spaces
    patterns=("${(@)patterns%%[[:space:]]##}")                    # trim trailing spaces
    patterns=("${(@)patterns:#}")                                 # remove empty lines

    local pat
    for pat in "${patterns[@]}"; do
        [[ -z "$pat" ]] && continue
        [[ "$test_path" == "$pat" ]] && return 0
    done

    return 1
}

__git_ai_process_repo() {
    local repo="$1" dry="$2" explain="$3"
    local -a remotes=("${(@)4}")
    local cp_var="$5" cso_var="$6" csg_var="$7" ca_var="$8"

    (
        cd "$repo" || return 1

        local repo_name branch repo_basename test_path origin_url

        # ── 1. Very cheap: parent .gsubignore check first ───────────────
        repo_basename="${PWD##*/}"
        test_path="${repo_basename}/"

        if __git_ai_should_skip_gsubignore "$repo" "$test_path"; then
            (( explain )) && print -P "skipped early by parent .gsubignore → %F{cyan}${repo_basename}%f"
            (( ${csg_var}++ ))
            return 0
        fi

        # ── 2. Now check origin (requires git + potentially network) ────
        origin_url=$(git remote get-url origin 2>/dev/null)
        if [[ -z "$origin_url" ]]; then
            (( explain )) && print -P "skipped (no origin) → %F{cyan}${repo_basename}%f"
            (( ${cso_var}++ ))
            return 0
        fi

        if __git_ai_should_skip_origin "$origin_url"; then
            (( explain )) && print -P "skipped (not my origin) → %F{cyan}${repo_basename}%f"
            (( ${cso_var}++ ))
            return 0
        fi

        # ── 3. Name validation (cheap, local) ───────────────────────────
        local repo_from_origin=${origin_url##*/}
        repo_from_origin=${repo_from_origin%.git}

        local path_based
        path_based=$(__git_ai_get_repo_name) || {
            (( explain )) && print -P "skipped (bad convention) → %F{cyan}${repo_from_origin}%f"
            (( ${cso_var}++ ))
            return 0
        }

        if [[ "$repo_from_origin" != "$path_based" ]]; then
            (( explain )) && print -P "%F{yellow}name mismatch%f → origin:${repo_from_origin} path:${path_based} → skipping"
            (( ${cso_var}++ ))   # or your mismatch counter
            return 0
        fi

        repo_name="$repo_from_origin"

        branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "main")

        # ── 4. Proceed ──────────────────────────────────────────────────
        local -a missing=()
        local r
        for r in "${remotes[@]}"; do
            git remote get-url "$r" &>/dev/null || missing+=("$r")
        done

        if (( ${#missing} == 0 )); then
            (( explain )) && print -P "already complete → %F{cyan}${repo_name}%f"
        else
            print -P "Processing %F{yellow}${repo_name}%f  (missing: ${missing[*]})"
            for r in "${missing[@]}"; do
                local url="git@github.com:${GIT_USER}/${repo_name}.git"
                if (( dry )); then
                    print "  would add ${r} → ${url}"
                else
                    git remote add "$r" "$url" 2>/dev/null \
                        && { print -P "  %F{green}added ${r}%f"; (( ${ca_var}++ )); } \
                        || print -P "  %F{yellow}${r} failed / already exists%f"
                fi
            done
        fi

        (( ${cp_var}++ ))
    )
}

__git_ai_print_summary() {
    local total="$1"          # total repos found
    local proc="$2"           # processed
    local skip="$3"           # total skipped
    local skip_o="$4"         # skipped: not my origin
    local skip_g="$5"         # skipped: .gsubignore
    local skip_m="$6"         # skipped: name mismatch
    local added="$7"          # remotes actually added

    print ""
    print -P "%F{blue}Summary:%f"
    print -P "  Found git repos total .... $total"
    print -P "  Processed ................ $proc"
    print -P "  Skipped total ............ $skip"
    print -P "    └─ not my origin ...... $skip_o"
    print -P "    └─ .gsubignore ........ $skip_g"
    print -P "    └─ name mismatch ...... $skip_m"
    (( added > 0 )) && print -P "  Remotes actually added ... $added"
}

# ── Helpers end ──────────────────────────────────────────────────────
# ======================================

git_ai::run_parallel() {
    local max="${1:-4}"
    shift

    local running=0

    for cmd in "$@"; do
        # Start the command in background
        eval "$cmd" &

        (( ++running ))

        # If at limit, wait for **any** one job to finish
        while (( running >= max )); do
            wait 2>/dev/null   # wait for next finished child (no -n/-p)
            (( --running ))
        done
    done

    # Wait for everything left
    wait
}

git_ai::repo_name() {
    local url
    url="$(git remote get-url origin 2>/dev/null)" || return 1
    print "${url:t:r}"
}

git_ai::branch() {
    git symbolic-ref --quiet --short HEAD 2>/dev/null \
    || git remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p' \
    || echo main
}

git_ai::repos() {
    local base="$1"
    find "$base" -type d -name ".git" -print0 | xargs -0 -n1 dirname
}

