# Public command
# Push to all AI remotes (xai, openai, anthropic, google, cursor)
git-ai-push() {
    local branch="${1:-$(git rev-parse --abbrev-ref HEAD)}"
    local -a ai_remotes=(xai openai anthropic google cursor)
    local -a existing=($(git remote | grep -F -x -f <(printf "%s\n" "${ai_remotes[@]}")))

    if (( ${#existing} == 0 )); then
        print -P "%F{yellow}No AI remotes found in this repo%f"
        return 0
    fi

    local r
    for r in "${existing[@]}"; do
        print -P "→ Pushing %F{cyan}${r}/${branch}%f"
        git push "$r" "$branch" || print -P "  %F{yellow}failed%f"
    done
}

git-ai-setup() {
    (( ${+GIT_USER} && $#GIT_USER )) || {
        print -P "%F{red}ERROR: GIT_USER is unset or empty. Cannot continue.%f"
        print -P "→ Run: source ~/.config/zsh/zsh-initgit.zsh"
        return 1
    }
    setopt NO_NOTIFY NO_MONITOR

    local dry=0 explain=0
    # local count_skipped_mismatch=0        # taken to below
    local -a only remotes=(xai openai anthropic google cursor)
    __git_ai_parse_args "$@" || return 1
    (( $#only )) && remotes=("${only[@]}")
    local target_dir="${PWD}"

# echo "\n\n\tbefore parsing....\n\n"
    # local -a repos
    # __git_ai_find_repos "$target_dir" repos || return 1
    local -a repos
    repos=($(__git_ai_find_repos "$target_dir"))

# echo "\n\n\tafter parsing.... \n\n"
    (( ${#repos} == 0 )) && {
        print -P "%F{yellow}No git repositories found under ${target_dir}%f"
        return 0
    }

    print -P "%F{blue}Found ${#repos} git repo(s)%f"

    local count_processed=0 count_skipped_origin=0 count_skipped_gsub=0 count_added=0 count_skipped_mismatch=0

    # ── Parallel version ─────────────────────────────────────────────

    local -a commands=()

    for repo in "${repos[@]}"; do
        # Important: we pass variable names by reference (as strings)
        commands+=("__git_ai_process_repo ${(qq)repo} $dry $explain ${(qq@)remotes} \
                        count_processed count_skipped_origin count_skipped_gsub count_skipped_mismatch count_added")
    done

    # Run with max 6 concurrent jobs (adjust to taste / your machine)
    git_ai::run_parallel 6 "${commands[@]}" || print -P "%F{yellow}Some parallel jobs failed%f"

    # After all jobs finished, the counters are updated because they are modified
    # in the parent scope (zsh nameref-like behavior via variable name passing)

    __git_ai_print_summary \
        "${#repos}" \
        "$count_processed" \
        "$((count_skipped_origin + count_skipped_gsub + count_skipped_mismatch))" \
        "$count_skipped_origin" \
        "$count_skipped_gsub" \
        "$count_skipped_mismatch" \
        "$count_added"

    unsetopt NO_NOTIFY NO_MONITOR

}

# ── Helpers ──────────────────────────────────────────────────────

__git_ai_parse_args() {
    local arg
    for arg in "$@"; do
        case "$arg" in
            --dry)               dry=1 ;;
            --explain-ignore)    explain=1 ;;
            --only=*)            only=(${(s:,:)arg#*=}) ;;
            *)                   print -P "%F{yellow}Unknown arg: $arg%f"; return 1 ;;
        esac
    done
}

