# ──────────────────────────────────────────────────────────────
# git-ai-status ── show overview table
# ──────────────────────────────────────────────────────────────

git-ai-status() {
    local base="${PWD}"

    # Header
    printf "%-30s %-12s %s\n" "REPO" "BRANCH" "REMOTES"

    local -a repos
    repos=(${(f)"$(find "$base" -type d -name .git -not -path '*/\.git/*' -prune 2>/dev/null | xargs -n1 dirname)"})

    for repo in "${repos[@]}"; do
        (
            cd "$repo" 2>/dev/null || return
            # Skip if no origin or origin doesn't contain GIT_USER (same logic as setup)
            local origin_url=$(git remote get-url origin 2>/dev/null)
            __git_ai_should_skip_origin "$origin_url" && return

            local repo_name branch remotes_list
            repo_name=$(__git_ai_get_repo_name)
            branch=$(git_ai::branch)
            remotes_list=$(git remote | tr '\n' ' ')

            printf "%-30s %-12s %s\n" "${repo_name:0:29}" "${branch:0:11}" "${remotes_list:-—}"
        )
    done
}

# ──────────────────────────────────────────────────────────────
# git-ai-doctor ── basic health check
# ──────────────────────────────────────────────────────────────

git-ai-doctor() {
    local base="${PWD}"

    local -a repos
    repos=(${(f)"$(find "$base" -type d -name .git -not -path '*/\.git/*' -prune 2>/dev/null | xargs -n1 dirname)"})

    local issues=0

    for repo in "${repos[@]}"; do
        (
            cd "$repo" 2>/dev/null || { ((issues++)); return; }

            local origin_url repo_name
            origin_url=$(git remote get-url origin 2>/dev/null)
            repo_name=$(__git_ai_get_repo_name)

            if [[ -z "$origin_url" ]]; then
                print -P "⚠ missing origin remote → %F{cyan}${repo_name}%f"
                ((issues++))
            fi

            if ! git symbolic-ref HEAD >/dev/null 2>&1; then
                print -P "⚠ detached HEAD → %F{cyan}${repo_name}%f"
                ((issues++))
            fi

            # Optional: warn if none of the AI remotes exist
            local has_ai=0
            for r in xai openai anthropic google cursor; do
                git remote get-url "$r" &>/dev/null && ((has_ai++))
            done
            (( has_ai == 0 )) && print -P "⚠ no AI remotes found → %F{cyan}${repo_name}%f"
        )
    done

    (( issues == 0 )) && print -P "%F{green}No obvious issues found.%f"
}
