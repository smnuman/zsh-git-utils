#!/usr/bin/env zsh
# source it in git-utils/git-ai-remotes

git_ai::scope() {
    if [[ $# -gt 0 ]]; then
        print -l -- "$@"
    elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git rev-parse --show-toplevel
    else
        print -u2 "✗ Not in a git repo and no paths provided"
        return 1
    fi
}

git_ai::discover_repos() {
    local path="$1"

    if [[ -d "$path/.git" ]]; then
        print "$path"
        find "$path" -mindepth 2 -type d -name ".git" -exec dirname {} \;
    else
        print -u2 "✗ $path is not a git repo"
    fi
}


